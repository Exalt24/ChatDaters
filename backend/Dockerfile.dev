# Local development image for the Rails API. Not used for the production deploy (see Dockerfile).
FROM ruby:3.4.10-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git curl libpq-dev libvips pkg-config postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails
ENV BUNDLE_PATH=/usr/local/bundle

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .
# A Windows checkout can turn the bin/ scripts into CRLF, which breaks their shebang lines.
RUN sed -i 's/\r$//' bin/*
EXPOSE 3000
CMD ["bash", "-c", "rm -f tmp/pids/server.pid && bin/rails db:prepare && bin/rails server -b 0.0.0.0 -p 3000"]
